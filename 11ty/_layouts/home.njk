<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Remote Planning Poker Web App for distributed software teams. Run real-time, peer-to-peer estimation sessions — no signup, no backend." />
    <title>{{ title }} - Planning Poker</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="bg-white text-gray-900">
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl">🃏</span>
          <span class="text-xl font-bold text-gray-900">Planning Poker</span>
        </a>
        <nav class="hidden md:flex items-center gap-8">
          <a href="#features" class="text-gray-600 hover:text-gray-900 font-medium">Features</a>
          <a href="#how-it-works" class="text-gray-600 hover:text-gray-900 font-medium">How It Works</a>
          <a href="#under-the-hood" class="text-gray-600 hover:text-gray-900 font-medium">Under the Hood</a>
          <a href="/docs/" class="text-gray-600 hover:text-gray-900 font-medium">Docs</a>
          <a href="/about/" class="text-gray-600 hover:text-gray-900 font-medium">About</a>
        </nav>
        <a
          href="/app/"
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-600 transition-colors"
        >
          Start a Session
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="bg-gray-900 text-white">
      <div class="max-w-7xl mx-auto py-12 px-4 grid gap-8 md:grid-cols-4">
        <div class="md:col-span-2">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-2xl">🃏</span>
            <span class="text-lg font-bold">Planning Poker</span>
          </div>
          <p class="text-gray-400 max-w-sm">
            Real-time, peer-to-peer estimation sessions for distributed software teams. No accounts, no backend, no data leaving your team's devices.
          </p>
        </div>
        <div>
          <h3 class="font-semibold mb-3 text-gray-200">Product</h3>
          <ul class="space-y-2 text-gray-400">
            <li><a href="/app/" class="hover:text-white">Launch App</a></li>
            <li><a href="#features" class="hover:text-white">Features</a></li>
            <li><a href="#how-it-works" class="hover:text-white">How It Works</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold mb-3 text-gray-200">Resources</h3>
          <ul class="space-y-2 text-gray-400">
            <li><a href="/docs/" class="hover:text-white">Docs</a></li>
            <li><a href="/about/" class="hover:text-white">About</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-800">
        <div class="max-w-7xl mx-auto py-6 px-4 flex flex-col sm:flex-row justify-between gap-2">
          <p class="text-gray-500 text-sm">&copy; 2026 Planning Poker. Built with React, Vite, 11ty, and Yjs CRDT.</p>
          <p class="text-gray-500 text-sm">No backend. No signup. Just estimate.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
